<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Kaldir.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:m="using:Kaldir.Models"
    xmlns:svc="using:Kaldir.Services"
    Title="Purge">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid x:Name="Root" Background="Transparent" AllowDrop="True" DragOver="OnDragOver" Drop="OnDrop">
        <Grid.RowDefinitions>
            <RowDefinition Height="32" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Custom title bar (sürüklenebilir alan), standart 32 px -->
        <StackPanel x:Name="AppTitleBar" Height="32" Padding="16,0,0,0" Orientation="Horizontal" Spacing="12">
            <Image Source="ms-appx:///Assets/Purge-32.png" Width="16" Height="16" VerticalAlignment="Center" />
            <TextBlock x:Name="TitleText" Text="Purge" VerticalAlignment="Center"
                       Style="{StaticResource CaptionTextBlockStyle}" />
        </StackPanel>

        <NavigationView x:Name="Nav" Grid.Row="1" PaneDisplayMode="Auto" IsBackButtonVisible="Collapsed"
                        IsSettingsVisible="True" OpenPaneLength="220"
                        CompactModeThresholdWidth="640" ExpandedModeThresholdWidth="1100"
                        IsTitleBarAutoPaddingEnabled="False" SelectionChanged="OnTabChanged">
            <NavigationView.MenuItems>
                <NavigationViewItem x:Name="TabPrograms" Content="Programs" Tag="programs" IsSelected="True">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE71D;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="TabStartup" Content="Startup" Tag="startup">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE7E8;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="TabTools" Content="Tools" Tag="tools">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE90F;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <!-- Page -->
            <Grid x:Name="PageGrid" Padding="32,8,32,12" RowSpacing="12" SizeChanged="OnPageSizeChanged">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Page header -->
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <TextBlock x:Name="PageTitle" Text="Programs" Style="{StaticResource TitleTextBlockStyle}" VerticalAlignment="Bottom" />
                        <TextBlock x:Name="CountText" Style="{StaticResource BodyTextBlockStyle}" Opacity="0.6" VerticalAlignment="Bottom" Margin="0,0,0,4" />
                        <ProgressRing x:Name="Busy" IsActive="True" Width="18" Height="18" VerticalAlignment="Bottom" Margin="0,0,0,5" />
                    </StackPanel>
                    <Button x:Name="ElevateBtn" Grid.Column="1" Padding="12,6" Click="OnElevate" Visibility="Collapsed" VerticalAlignment="Center"
                            ToolTipService.ToolTip="Restart as administrator">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xEA18;" FontSize="14" />
                            <TextBlock x:Name="ElevateLabel" Text="Restart as administrator" />
                        </StackPanel>
                    </Button>
                </Grid>

                <!-- Errors from any page -->
                <InfoBar x:Name="ErrorBar" Grid.Row="1" Severity="Error" IsOpen="False" IsClosable="True" />

                <!-- Search / filter -->
                <Grid x:Name="SearchRow" Grid.Row="2" ColumnSpacing="8" RowSpacing="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <AutoSuggestBox x:Name="SearchBox" PlaceholderText="Search apps" QueryIcon="Find" TextChanged="OnFilterChanged" />
                    <ComboBox x:Name="SourceBox" Grid.Column="1" Width="160" SelectedIndex="0" SelectionChanged="OnFilterChanged">
                        <ComboBoxItem Content="All" />
                        <ComboBoxItem Content="Desktop programs" />
                        <ComboBoxItem Content="Store apps" />
                    </ComboBox>
                    <ComboBox x:Name="SortBox" Grid.Column="2" Width="160" SelectedIndex="0" SelectionChanged="OnFilterChanged">
                        <ComboBoxItem Content="By name" />
                        <ComboBoxItem Content="By size" />
                        <ComboBoxItem Content="By install date" />
                        <ComboBoxItem Content="By publisher" />
                    </ComboBox>
                    <Button x:Name="RefreshBtn" Grid.Column="3" Click="OnRefresh" ToolTipService.ToolTip="Refresh" Height="32" Width="40" Padding="0">
                        <FontIcon Glyph="&#xE72C;" FontSize="14" />
                    </Button>
                </Grid>

                <!-- Programs list (card) -->
                <Grid x:Name="ListGrid" Grid.Row="3" CornerRadius="8" BorderThickness="1"
                      Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                      BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="40" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid x:Name="ColHeader" Padding="16,0,28,0"
                          BorderThickness="0,0,0,1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="48" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="{x:Bind m:UiState.Current.SizeCol, Mode=OneWay}" />
                            <ColumnDefinition Width="{x:Bind m:UiState.Current.DateCol, Mode=OneWay}" />
                            <ColumnDefinition Width="{x:Bind m:UiState.Current.TypeCol, Mode=OneWay}" />
                        </Grid.ColumnDefinitions>
                        <CheckBox x:Name="SelectAllChk" MinWidth="0" Padding="0" Click="OnSelectAll" ToolTipService.ToolTip="Select all" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="Name" Margin="40,0,0,0" Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.7" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="2" Text="Size" Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.7" HorizontalAlignment="Right" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="3" Text="Installed" Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.7" HorizontalAlignment="Right" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="4" Text="Type" Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.7" HorizontalAlignment="Right" VerticalAlignment="Center" />
                    </Grid>
                    <ListView x:Name="AppList" Grid.Row="1" SelectionMode="Multiple" SelectionChanged="OnSelectionChanged" IsItemClickEnabled="False" Padding="0,4">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="m:AppEntry">
                                <Grid Padding="0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="{x:Bind m:UiState.Current.SizeCol, Mode=OneWay}" />
                                        <ColumnDefinition Width="{x:Bind m:UiState.Current.DateCol, Mode=OneWay}" />
                                        <ColumnDefinition Width="{x:Bind m:UiState.Current.TypeCol, Mode=OneWay}" />
                                    </Grid.ColumnDefinitions>
                                    <Grid Width="32" Height="32" VerticalAlignment="Center" Margin="0,0,12,0">
                                        <FontIcon Glyph="{x:Bind Glyph}" FontSize="20" Opacity="0.7" Visibility="{x:Bind GlyphVisibility, Mode=OneWay}" />
                                        <Image Source="{x:Bind Icon, Mode=OneWay}" Width="32" Height="32" />
                                    </Grid>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                                        <TextBlock Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" FontWeight="SemiBold" />
                                        <TextBlock Text="{x:Bind SubText}" Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.6" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="2" Text="{x:Bind SizeText, Mode=OneWay}" HorizontalAlignment="Right" VerticalAlignment="Center" Opacity="0.85" />
                                    <TextBlock Grid.Column="3" Text="{x:Bind DateText}" HorizontalAlignment="Right" VerticalAlignment="Center" Opacity="0.6" />
                                    <Border Grid.Column="4" HorizontalAlignment="Right" VerticalAlignment="Center" CornerRadius="4" Padding="8,2"
                                            Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                                        <TextBlock Text="{x:Bind SourceText}" Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.8" TextWrapping="NoWrap" />
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>

                <!-- Bottom bar (card) -->
                <Grid x:Name="BottomBar" Grid.Row="4" ColumnSpacing="12" Padding="16,12" CornerRadius="8" BorderThickness="1"
                      Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                      BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel x:Name="BottomChecks" Orientation="Horizontal" Spacing="20" VerticalAlignment="Center">
                        <CheckBox x:Name="SilentChk" Content="Silent uninstall" IsChecked="True" MinWidth="0"
                                  ToolTipService.ToolTip="Runs uninstallers with no windows (MSI, Inno Setup, NSIS, Squirrel, WiX Burn, winget, Chromium). If an uninstaller has no silent mode you can force-remove it instead." />
                        <CheckBox x:Name="LeftoverChk" Content="Scan leftovers after" IsChecked="True" MinWidth="0" />
                        <CheckBox x:Name="RestoreChk" Content="Restore point (admin)" MinWidth="0" />
                    </StackPanel>
                    <Grid x:Name="BottomButtons" Grid.Column="1" ColumnSpacing="8" VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button x:Name="ScanBtn" Content="Scan leftovers" Click="OnScanOnly" IsEnabled="False" HorizontalAlignment="Stretch" />
                        <Button x:Name="ForceBtn" Grid.Column="1" Content="Force uninstall" Click="OnForce" IsEnabled="False" HorizontalAlignment="Stretch" />
                        <Button x:Name="UninstallBtn" Grid.Column="2" Click="OnUninstall" IsEnabled="False" Style="{StaticResource AccentButtonStyle}" MinWidth="120" HorizontalAlignment="Stretch">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE74D;" FontSize="14" />
                                <TextBlock Text="Uninstall" />
                            </StackPanel>
                        </Button>
                    </Grid>
                </Grid>

                <!-- Status line: every page -->
                <TextBlock x:Name="StatusText" Grid.Row="5" Text="Ready. Drop an .exe, shortcut or folder on this window to uninstall it."
                           TextTrimming="CharacterEllipsis" Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.7" />

                <!-- Startup page -->
                <Grid x:Name="StartupView" Grid.Row="2" Grid.RowSpan="3" Visibility="Collapsed" RowSpacing="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <InfoBar x:Name="StartupInfo" IsOpen="True" IsClosable="False" Severity="Informational"
                             Message="Turning a switch off does not delete the entry, it only stops it from starting with Windows (same as Settings &gt; Startup apps)." />
                    <ListView x:Name="StartupList" Grid.Row="1" SelectionMode="None">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Margin" Value="0,0,0,4" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="svc:StartupEntry">
                                <Grid Padding="16,10" MinHeight="64" CornerRadius="8" BorderThickness="1"
                                      Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                      BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="{x:Bind m:UiState.Current.LocCol, Mode=OneWay}" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <FontIcon Glyph="&#xE7E8;" FontSize="18" Opacity="0.7" VerticalAlignment="Center" Margin="0,0,16,0" />
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                                        <TextBlock Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" FontWeight="SemiBold" />
                                        <TextBlock Text="{x:Bind Command}" Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.6" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="2" Text="{x:Bind Location}" VerticalAlignment="Center" Margin="16,0,0,0" Opacity="0.6" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Style="{StaticResource CaptionTextBlockStyle}" />
                                    <ToggleSwitch Grid.Column="3" IsOn="{x:Bind Enabled}" OnContent="On" OffContent="Off" MinWidth="0" Margin="16,0,0,0" Toggled="OnStartupToggled" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>

                <!-- Tools page: kartlar genişliği doldurur, sütun sayısı pencereye göre değişir -->
                <ScrollViewer x:Name="ToolsView" Grid.Row="2" Grid.RowSpan="3" Visibility="Collapsed" Padding="0,0,4,0">
                    <ItemsRepeater x:Name="ToolsGrid" ElementPrepared="OnToolElementPrepared">
                        <ItemsRepeater.Layout>
                            <UniformGridLayout MinItemWidth="300" MinItemHeight="84" MinColumnSpacing="8" MinRowSpacing="8" ItemsStretch="Fill" />
                        </ItemsRepeater.Layout>
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate x:DataType="m:ToolTile">
                                <Button Padding="16,12" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                        HorizontalContentAlignment="Stretch" CornerRadius="8" AutomationProperties.Name="{x:Bind Title}">
                                    <Grid ColumnSpacing="16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Border Width="40" Height="40" CornerRadius="8" VerticalAlignment="Center"
                                                Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                                            <FontIcon Glyph="{x:Bind Glyph}" FontSize="20" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                            <TextBlock Text="{x:Bind Title}" FontWeight="SemiBold" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{x:Bind Sub}" Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.65" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <FontIcon Grid.Column="2" Glyph="&#xE76C;" FontSize="12" Opacity="0.5" VerticalAlignment="Center" />
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>
                </ScrollViewer>

                <!-- Settings page: Windows 11 Ayarlar düzeninde kartlar -->
                <ScrollViewer x:Name="SettingsView" Grid.Row="2" Grid.RowSpan="3" Visibility="Collapsed" Padding="0,0,4,0">
                    <StackPanel Spacing="4" MaxWidth="1000" HorizontalAlignment="Stretch">
                        <StackPanel.Resources>
                            <Style x:Key="Card" TargetType="Grid">
                                <Setter Property="Padding" Value="16,12" />
                                <Setter Property="MinHeight" Value="68" />
                                <Setter Property="CornerRadius" Value="6" />
                                <Setter Property="BorderThickness" Value="1" />
                                <Setter Property="ColumnSpacing" Value="16" />
                                <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
                                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
                            </Style>
                            <Style x:Key="Section" TargetType="TextBlock" BasedOn="{StaticResource BodyStrongTextBlockStyle}">
                                <Setter Property="Margin" Value="2,20,0,6" />
                            </Style>
                        </StackPanel.Resources>

                        <TextBlock Text="Appearance" Style="{StaticResource Section}" Margin="2,0,0,6" />
                        <Grid Style="{StaticResource Card}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <FontIcon Glyph="&#xE790;" FontSize="18" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="App theme" />
                                <TextBlock Text="Light, dark, or follow Windows" Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.65" />
                            </StackPanel>
                            <ComboBox x:Name="ThemeBox" Grid.Column="2" MinWidth="180" VerticalAlignment="Center" SelectionChanged="OnThemeChanged">
                                <ComboBoxItem Content="Use system setting" Tag="System" />
                                <ComboBoxItem Content="Light" Tag="Light" />
                                <ComboBoxItem Content="Dark" Tag="Dark" />
                            </ComboBox>
                        </Grid>
                        <Grid Style="{StaticResource Card}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <FontIcon Glyph="&#xE771;" FontSize="18" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="Window material" />
                                <TextBlock Text="Mica tints with your wallpaper, Acrylic blurs what is behind the window" Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.65" TextWrapping="Wrap" />
                            </StackPanel>
                            <ComboBox x:Name="BackdropBox" Grid.Column="2" MinWidth="180" VerticalAlignment="Center" SelectionChanged="OnBackdropChanged">
                                <ComboBoxItem Content="Mica" Tag="Mica" />
                                <ComboBoxItem Content="Mica Alt" Tag="MicaAlt" />
                                <ComboBoxItem Content="Acrylic (blur)" Tag="Acrylic" />
                                <ComboBoxItem Content="Solid" Tag="Solid" />
                            </ComboBox>
                        </Grid>

                        <TextBlock Text="Uninstall" Style="{StaticResource Section}" />
                        <Grid Style="{StaticResource Card}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <FontIcon Glyph="&#xE7ED;" FontSize="18" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="Silent uninstall" />
                                <TextBlock Text="Run uninstallers with no windows; programs without a silent mode ask before force-removing" Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.65" TextWrapping="Wrap" />
                            </StackPanel>
                            <ToggleSwitch x:Name="SetSilent" Grid.Column="2" MinWidth="0" OnContent="On" OffContent="Off" Toggled="OnSettingToggled" />
                        </Grid>
                        <Grid Style="{StaticResource Card}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <FontIcon Glyph="&#xE721;" FontSize="18" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="Scan for leftovers after uninstall" />
                                <TextBlock Text="Lists folders, registry keys, services and tasks the uninstaller left behind" Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.65" TextWrapping="Wrap" />
                            </StackPanel>
                            <ToggleSwitch x:Name="SetLeftovers" Grid.Column="2" MinWidth="0" OnContent="On" OffContent="Off" Toggled="OnSettingToggled" />
                        </Grid>
                        <Grid Style="{StaticResource Card}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <FontIcon Glyph="&#xE81C;" FontSize="18" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="Create a restore point first" />
                                <TextBlock x:Name="RestoreHint" Text="Needs administrator rights" Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.65" TextWrapping="Wrap" />
                            </StackPanel>
                            <ToggleSwitch x:Name="SetRestore" Grid.Column="2" MinWidth="0" OnContent="On" OffContent="Off" Toggled="OnSettingToggled" />
                        </Grid>
                        <Grid Style="{StaticResource Card}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <FontIcon Glyph="&#xE765;" FontSize="18" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="Easy Uninstall hotkey" />
                                <TextBlock x:Name="HotKeyHint" Text="Press the hotkey on any app window to uninstall it" Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.65" TextWrapping="Wrap" />
                            </StackPanel>
                            <ToggleSwitch x:Name="SetHotKey" Grid.Column="2" MinWidth="0" OnContent="On" OffContent="Off" Toggled="OnSettingToggled" />
                        </Grid>

                        <TextBlock Text="Data" Style="{StaticResource Section}" />
                        <Grid Style="{StaticResource Card}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <FontIcon Glyph="&#xE81C;" FontSize="18" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="Uninstall history" />
                                <TextBlock Text="Every uninstall Purge ran, with method and result" Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.65" TextWrapping="Wrap" />
                            </StackPanel>
                            <Button Grid.Column="2" Content="Open" Tag="history" Click="OnOpenData" VerticalAlignment="Center" />
                        </Grid>
                        <Grid Style="{StaticResource Card}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <FontIcon Glyph="&#xE8F1;" FontSize="18" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="Registry backups" />
                                <TextBlock Text=".reg files saved before Purge deletes registry keys; double-click one to restore it" Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.65" TextWrapping="Wrap" />
                            </StackPanel>
                            <Button Grid.Column="2" Content="Open folder" Tag="backups" Click="OnOpenData" VerticalAlignment="Center" />
                        </Grid>
                        <Grid Style="{StaticResource Card}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <FontIcon Glyph="&#xE896;" FontSize="18" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="Install Monitor logs" />
                                <TextBlock Text="What each monitored installer added" Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.65" TextWrapping="Wrap" />
                            </StackPanel>
                            <Button Grid.Column="2" Content="Open folder" Tag="monitor" Click="OnOpenData" VerticalAlignment="Center" />
                        </Grid>

                        <TextBlock Text="About" Style="{StaticResource Section}" />
                        <Grid Style="{StaticResource Card}" Margin="0,0,0,12">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <Image Source="ms-appx:///Assets/Purge-32.png" Width="24" Height="24" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="Purge" />
                                <TextBlock x:Name="AboutText" Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.65" TextWrapping="Wrap" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </NavigationView>
    </Grid>
</Window>
